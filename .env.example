# Supply local credentials through private environment configuration.
DATABASE_URL=
DATABASE_URL_NON_POOLING=
# Generate independently, for example: openssl rand -hex 32
SECRET_KEY=
CRON_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_EXPIRATION_HOURS=24
SESSION_ABSOLUTE_LIFETIME_HOURS=168
# Set only when your ingress strips client-supplied forwarding headers.
# Count trusted proxies from the right of X-Forwarded-For. 0 ignores that header.
TRUST_PROXY_HOPS=0
API_RATE_LIMIT_WINDOW_MINUTES=1
API_RATE_LIMIT_MAX_REQUESTS=120
